# This Pipfile contains dependencies from all subprojects.
# It should be used for convenience only during development!
# During deployment, each subproject uses its own dependencies.

[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[requires]
python_version = "3.11"

[packages]
## Common module dependencies ##
bson = "==0.5.10"
cachetools = "==7.0.1"
fastapi = "==0.131.0"
httpx = "==0.28.1"
psutil = "==7.2.2"
pydantic = "==2.12.5"
pydantic-settings = "==2.14.2"
python-dateutil = "==2.9.0.post0"
python-multipart = "==0.0.22"
requests = "==2.32.5"
starlette = "==0.52.1"

## Common module dependencies (optional) ##
dnspython = "==2.8.0"
elasticsearch = "==8.17.2"
openai = "==2.21.0"
pyjwt = { extras = ["crypto"], version = "==2.13.0" }
pymongo = "==4.16.0"

## Component dependencies ##
azure-identity = "==1.25.2"
azure-storage-blob = "==12.28.0"
beautifulsoup4 = "==4.14.3"
docling = "==2.111.0"
gevent = "==25.9.1"
langchain = "==1.2.10"
langchain-community = "==0.4.1"
langchain-openai = "==1.1.10"
langchain-text-splitters = "==1.1.1"
minio = "==7.2.20"
numpy = "==2.4.2"
openpyxl = "==3.1.5"
pymupdf = "==1.27.1"
pypdfium2 = "==5.11.0"
python-docx = "==1.2.0"
python-pptx = "==1.0.2"
tritonclient = { extras = ["http"], version = "==2.65.0" }
uvicorn = { extras = ["standard"], version = "==0.41.0" }

[dev-packages]
einops = "==0.8.2"
scikit-learn = "==1.8.0"
sentence-transformers = "==5.2.3"
torch = "==2.10.0"
tqdm = "==4.67.3"
transformers = "==5.2.0"

[pipenv]
# Keep disabled to preserve the visual separation of the common & component dependencies.
sort_pipfile = false
